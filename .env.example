# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Get an API key from n8n: Settings → n8n API → Create an API key.
# The key is instance-specific. A Cloud key will not work against self-hosted.

# --- cloud: n8n Cloud Pro, production runtime ---
N8N_CLOUD_URL=https://victor-id.app.n8n.cloud
N8N_CLOUD_API_KEY=

# --- selfhosted: Hetzner VPS, staging. Arrives in Build 0b. ---
# Leave blank until 0b. Scripts fail with a clear message if you target
# an instance that has no URL or key set.
N8N_SELFHOSTED_URL=
N8N_SELFHOSTED_API_KEY=

# Scope pull.sh to this repo. One n8n instance serves every build, so an
# unscoped pull drags in other repos' workflows. Use --all to override.
PULL_PREFIX=ap-
